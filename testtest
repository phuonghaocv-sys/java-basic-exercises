**Bài 3: Điểm trung bình & xếp loại**\
public class Bai3 {
    public static void main(String[] args) {
        int diem1 = 10;
        int diem2 = 8;
        int diem3 = 5;
        int diemtb = (diem1+diem2+diem3)/3;
        if(diemtb>=8.5){
            System.out.println("avg=" + diemtb + "," + "Gioi");
        } else if(diemtb>=6.5){
            System.out.println("avg=" + diemtb + "," + "Kha");
        } else if(diemtb>=5){
            System.out.println("avg=" + diemtb + "," + "Trung binh");
        } else{
            System.out.println("avg=" + diemtb + "," + "Yeu");
        }
    }
}
